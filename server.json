{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.aftertaxau/au-compliance-kit",
  "description": "Australian take-home pay, PAYG withholding, income tax, HELP, super and GST from the ATO's formulas",
  "repository": {
    "url": "https://github.com/aftertaxau/au-compliance-kit",
    "source": "github"
  },
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "au-compliance-kit",
      "version": "0.3.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://aftertaxau.com/mcp"
    }
  ]
}
